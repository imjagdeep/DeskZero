{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and the search window: core APIs, dialogs, updater",
  "windows": [
    "main",
    "spotlight"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-save",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "updater:default",
    "process:allow-restart"
  ]
}
