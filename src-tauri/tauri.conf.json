{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super Folder",
  "version": "0.2.1",
  "identifier": "app.superfolder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Super Folder",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "spotlight",
        "title": "Super Folder Search",
        "width": 720,
        "height": 470,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jagdeep Sandhu",
    "copyright": "Copyright (c) 2026 Jagdeep Sandhu. MIT License.",
    "category": "Utility",
    "shortDescription": "Offline file organizer",
    "longDescription": "Super Folder keeps your folders organized with simple rules. Offline, private, no account. Preview before moving, undo any batch.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGRUZCQzU2QUExNzk5MTIKUldRU21SZXFWcnp2eno5NFVHNFFNUnJ0V3lvWGIrb0VTUU05S0dwRUlsb2M1b3NRSStwV003SjkK",
      "endpoints": [
        "https://github.com/imjagdeep/super-folder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
